# =============================================================================
#  Copie para ".env" e ajuste os valores:   cp .env.example .env
#  O arquivo .env NÃO deve ir para o Git (já está no .gitignore).
#  Use apenas letras e números nas senhas (evita problemas de escape).
# =============================================================================

# Ambiente do ASP.NET Core: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Porta da API na sua máquina (Swagger em http://localhost:8080)
API_PORT=8080

# Imagem/versão (localmente o compose faz o build e usa esta tag)
API_IMAGE=aquamonitor-api:local
APP_VERSION=local

# Oracle (container gvenzl/oracle-free)
ORACLE_PASSWORD=TroqueSenhaSys123          # senha do SYS/SYSTEM
ORACLE_APP_USER=aquamonitor                # usuário/schema da aplicação
ORACLE_APP_PASSWORD=TroqueSenhaApp123      # senha do usuário da aplicação

# Chave de assinatura do JWT (mínimo 32 caracteres)
JWT_KEY=TroqueEstaChaveJwtPorUmaComMaisDe32Caracteres
